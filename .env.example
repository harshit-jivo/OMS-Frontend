# Copy to `.env` for local development:  cp .env.example .env
# `.env` is gitignored; this template is not.

# Backend API base URL. Read by client code via import.meta.env.
VITE_API_BASE_URL=http://localhost:8000/api

# The build number is NOT set here. Releases take it from `.env.production`
# (committed), which `npm run build` reads via loadEnv() in vite.config.ts.
# `npm run dev` does not need one and reports build 0 without it.
#
# The app version is NOT set here either — it comes from package.json "version".
# See "OMS Backend/docs/RELEASE.md" -> "React web release process".
