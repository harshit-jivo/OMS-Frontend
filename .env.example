# Copy to `.env` for local development:  cp .env.example .env
# `.env` is gitignored; this template is not.

# Backend API base URL. Read by client code via import.meta.env.
VITE_API_BASE_URL=http://localhost:8000/api

# API version segment. Leave UNSET for the unversioned /api/ prefix, which is
# what every deployed server serves today.
#
# The backend mounts the entire API twice — /api/ and /api/v1/ — at the same
# views, so switching is a prefix change and nothing else. Set this to `v1`
# only AFTER the server you are building against has shipped that mount;
# a build that asks for /api/v1/ against a server without it 404s every
# request. Rolling back is the same edit in reverse.
#
#VITE_API_VERSION=v1

# The build number is NOT set here. Releases take it from `.env.production`
# (committed), which `npm run build` reads via loadEnv() in vite.config.ts.
# `npm run dev` does not need one and reports build 0 without it.
#
# The app version is NOT set here either — it comes from package.json "version".
# See "OMS Backend/docs/RELEASE.md" -> "React web release process".
