; npm 12+ blocks "remote" (URL) dependencies by default (allow-remote=none).
; This project's `xlsx` dependency is pinned to SheetJS's own CDN tarball,
; because the npm-registry copy of xlsx is unmaintained. "root" permits remote
; deps declared in this package.json only — transitive ones stay blocked.
allow-remote = root

; esbuild's postinstall fetches its platform binary; Vite cannot start without it.
allow-scripts[] = "esbuild"
